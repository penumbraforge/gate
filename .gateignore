# Gate self-scan ignore patterns
# These suppress false positives when Gate scans its own source code.

# Test fixtures — intentional fake secrets used for testing
src/cli/__tests__/**
test/**
github-action/test/**

# Rule definitions — contain example secret patterns by design
rules/rules.json
rules/fortress.js

# Rule source — contains regex patterns and PEM header strings for detection
src/cli/rules.js

# FORTRESS rule loader — maps rules.json patterns, trips generic assignment rules
src/cli/rules-loader.js

# Scanner engine — finding-construction code and regex literals trip the
# generic assignment rules
src/cli/scanner.js

# History scanner — finding-construction code and purge-script templates
# trip the generic assignment rules
src/cli/history.js

# Credential verifier — references token patterns for API verification
src/cli/verify.js

# Documentation — contains example commands, configs, and placeholder secrets
GUIDE.md
README.md
CHANGELOG.md

# .env.example — placeholder values, not real credentials
.env.example

# Lockfile — npm integrity hashes are high-entropy but not secrets
package-lock.json

# GitHub Action — example configs, action metadata, and token-handling code
github-action/**

# Release/build scripts
scripts/**
