{
  "name": "@penumbraforge/gate",
  "version": "2.1.0",
  "description": "Gate: Zero-config secret scanner with auto-fix. Finds secrets, fixes them, for free.",
  "main": "src/cli/scanner.js",
  "bin": {
    "gate": "bin/gate.js"
  },
  "scripts": {
    "test": "jest",
    "test:cli": "jest --selectProjects cli",
    "test:watch": "jest --watch",
    "build:action": "ncc build github-action/action.js -o github-action/dist --minify",
    "docs": "node scripts/gen-docs.js",
    "prepublishOnly": "npm test && node bin/gate.js scan --all"
  },
  "keywords": [
    "security",
    "secrets",
    "pre-commit",
    "github-actions",
    "pii",
    "compliance",
    "zero-trust"
  ],
  "author": "PenumbraForge",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/penumbraforge/gate.git"
  },
  "homepage": "https://github.com/penumbraforge/gate",
  "bugs": {
    "url": "https://github.com/penumbraforge/gate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "bin",
    "src/cli",
    "!src/cli/__tests__",
    "rules",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@vercel/ncc": "^0.38.4",
    "jest": "^30.2.0"
  }
}
